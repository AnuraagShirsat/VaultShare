# VaultShare Environment Variables Example
# Copy this file to .env and adjust values for your environment.

# Flask Application Settings
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Settings
# Default is an SQLite database inside the instance/ directory
DATABASE_URI=sqlite:///instance/vaultshare.db

# Storage Settings
# Directory where encrypted files are stored
STORAGE_DIR=storage
# Maximum upload file size in bytes (16 MB = 16777216 bytes)
MAX_CONTENT_LENGTH=16777216

# Rate Limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
